[say]
source = "auto"
target = "ja"
mode = "realtime"
style = "spoken"
polite = "polite"
profanity = "mask"
simplify = false
preserve_technical_terms = true

[say.llm]
# Optional command-specific overrides; otherwise Say uses global [ai].
# provider = "openai"
# model = "your-model"
timeout = "30s"
