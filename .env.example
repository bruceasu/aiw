# 环境变量配置模板。完整说明：docs/usage/environment-variables.md
# 按需取消注释并填写值；示例路径和模型不一定适合本机。
# 可选项保持注释可保留 TOML 配置和自动检测；空值不总等于未设置。
# 不要把实际密钥提交到版本库。无默认密钥的项目使用空白占位。
#
# 加载位置：主 aiw 只自动加载可执行文件同目录的 .env；已有进程变量
# （包括空值）优先。根 build.py 加载仓库根 .env，相对发布路径按仓库根解析。
# Python/Node 插件和独立程序不统一自动加载此文件；需由 aiw 启动继承，
# 或由启动环境提供变量。旧 Teams 脚本会用自己的环境文件覆盖进程变量。

# --- 本地包仓库、安装与开发工具 ---
# 发布仓库：必须为本地路径，无内置默认；以下保留原模板示例，使用前修改。
AIW_PACKAGE_REPO=d:/playground/aiw-packages
# 包版本：--version 优先；根 build.py 缺省使用带 UTC 时间的 snapshot。
# 独立打包入口在此变量未设置时要求 --version；编译槽固定为 snapshot。
# AIW_VERSION=1.2.3
# 根 build.py 的 Go 工具：默认 PATH 中 go；根 compile 脚本不读取此覆盖。
# AIW_GO="C:/Program Files/Go/bin/go.exe"
# Node：插件默认配置/捆绑 Node/PATH；build.py 默认 PATH 中 node。
# 显式插件解释器必须为现存绝对文件路径。
# AIW_NODE="C:/Program Files/nodejs/node.exe"
# Python：环境 > 用户 runtime 配置 > 程序配置 > 捆绑 Python > PATH。
# AIW_PYTHON=C:/Python313/python.exe
# 安装目标：Windows 默认 C:/green/aiw；其他系统默认 ~/apps/aiw。
# AIW_INSTALL_DIR=C:/green/aiw
# Skill 源目录：默认自动查找源码/安装树；显式指定后使用该根。
# AIW_SKILLS_SOURCE_ROOT=C:/path/to/aiw/src/skills
# req/packer 二进制：默认插件同目录 aiw-req[.exe]/aiw-packer[.exe]。
# AIW_REQ_BINARY=C:/path/to/aiw/plugins/aiw-req/aiw-req.exe
# AIW_PACKER_BINARY=C:/path/to/aiw/plugins/aiw-packer/aiw-packer.exe
# 根 compile 脚本 Go 缓存：默认 <repo>/.ai/compile-cache/go。
# AIW_GOCACHE=C:/path/to/aiw/.ai/compile-cache/go

# --- 工作流、会话与通用集成 ---
# FD 角色 runner 文件：无默认；未设置则保留 pending handoff，不自动启动。
# AIW_FD_ROLE_RUNNER=C:/path/to/role-runner.py
# Shell：powershell/bash/zsh/fish；默认根据 SHELL、PSModulePath 检测。
# AIW_SHELL=powershell
# Codex 数据目录：默认用户目录下 .codex；不要设为空字符串。
# CODEX_HOME=C:/Users/your-name/.codex
# Git guide 模型：默认 gpt-6-luna。
# AIW_GIT_GUIDE_MODEL=gpt-6-luna
# GitHub 令牌：无默认。
# GITHUB_TOKEN=
# Issue Session：通常由会话流程提供，无默认，不要全局固定。
# AIW_ISSUE_SESSION=
# 旧 Requirement 兼容绑定：无默认，按本次会话需要提供。
# AIW_REQUIREMENT_SESSION=

# --- Go 全局 AI 配置 ---
# 通常：AIW_LLM_* > provider 环境 > TOML；本次显式/Session 可覆盖 provider/model。
# 旧 RunLLM：显式配置 > 进程环境 > cwd/.env > AIW_ROOT/.env > exe/.env > 默认。
# 先按 TOML provider 读专属变量，再应用 AIW_LLM_PROVIDER；跨 provider 切换时
# 同时明确模型、地址、密钥。此组不配置 Python cz 或 Node ai。
# Provider：openai/gemini/ollama/llama.cpp/codex/copilot；未设由配置/调用决定。
# AIW_LLM_PROVIDER=openai
# 以下无统一默认；未设时使用配置、provider 变量或 provider 默认。
# AIW_LLM_MODEL=
# AIW_LLM_BASE_URL=
# AIW_LLM_API_KEY=
# OpenAI：默认模型 gpt-4o-mini、默认 API 根地址如下；密钥无默认。
# say 也读取 key/base；Python cz 只用 key 作后备，不用 model/base。
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# Gemini 默认值；密钥无默认。
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_API_KEY=
# Ollama 默认值；密钥无默认，旧 RunLLM 不读取此专属密钥变量。
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=
# llama.cpp 默认值；密钥无默认，旧 RunLLM 不读取此专属密钥变量。
# LLAMACPP_MODEL=local-model
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LLAMACPP_API_KEY=
# 旧 Go LLM 来源调试：默认关闭；1/true/yes/on 开启。
# AIW_CZ_DEBUG=0

# --- Python aiw cz：独立 CZ_* 配置 ---
# 环境覆盖 cz TOML，空字符串也可能覆盖。Provider 无默认。
# CZ_LLM_PROVIDER=openai
# 模型/密钥/base 配置槽默认取 TOML，否则为空。
# OpenAI 必须提供模型；密钥可回退 OPENAI_API_KEY，base 最终回退官方地址。
# CZ_OPENAI_MODEL=
# CZ_OPENAI_API_KEY=
# CZ_OPENAI_BASE_URL=https://api.openai.com/v1
# Codex/Copilot CLI 不直接使用 api_key/base_url 配置槽。
# CZ_CODEX_MODEL=
# CZ_CODEX_API_KEY=
# CZ_CODEX_BASE_URL=
# CZ_COPILOT_MODEL=
# CZ_COPILOT_API_KEY=
# CZ_COPILOT_BASE_URL=
# Codex 命令默认 PATH 中 codex；Copilot 必须显式配置命令，以下仅为示例。
# CZ_CODEX_COMMAND=codex
# CZ_COPILOT_COMMAND=copilot
# 语言：显式请求 > CZ_LANGUAGE > 配置 > 系统语言 > en；支持 en/zh/ja。
# CZ_LANGUAGE=zh
# 已拒绝的旧参数接口：不要填写非空值，否则报错。
# CZ_CODEX_ARGS=
# CZ_COPILOT_ARGS=

# --- Node aiw ai：Agent Gateway 客户端 ---
# 逻辑模型默认 gpt-6-luna，需在网关配置并授权。
# AIW_AI_MODEL=gpt-6-luna
# 网关 Key：无默认，至少 43 字符且无空白；不回退 OPENAI_API_KEY。
# AIW_AI_API_KEY=
# 客户端默认端口 43127；显式 URL 优先，默认 host 固定为 127.0.0.1。
# 也是独立 proxy 的兼容监听端口。
# AIW_AGENT_PROXY_PORT=43127
# 已移除：非空即报错，不要启用。
# AIW_AI_PROVIDER=

# --- 独立 HTTP OpenAI Proxy ---
# 规范变量优先于兼容变量；空字符串继续回退。
# 监听 IPv4：HTTP_OPENAI_PROXY_HOST > AIW_AGENT_PROXY_HOST > 127.0.0.1。
# HTTP_OPENAI_PROXY_HOST=127.0.0.1
# AIW_AGENT_PROXY_HOST=127.0.0.1
# 监听端口：HTTP_OPENAI_PROXY_PORT > AIW_AGENT_PROXY_PORT > 43127。
# HTTP_OPENAI_PROXY_PORT=43127
# 状态目录：规范变量 > 兼容变量 > 系统临时目录/http-openai-proxy。
# HTTP_OPENAI_PROXY_STATE_DIR=C:/path/to/proxy-state
# AIW_AGENT_PROXY_STATE_DIR=C:/path/to/proxy-state
# 上游 Key：规范变量 > OPENAI_API_KEY，无内置密钥。
# HTTP_OPENAI_PROXY_API_KEY=
# 上游模式：规范变量 > OPENAI_API_PROFILE > openai；也支持 aiw_gateway。
# HTTP_OPENAI_PROXY_API_PROFILE=openai
# OPENAI_API_PROFILE=openai
# 上游根地址：规范变量 > OPENAI_BASE_URL > 官方地址；仅 HTTPS/loopback HTTP。
# HTTP_OPENAI_PROXY_BASE_URL=https://api.openai.com/v1

# --- 动态命名的凭据 ---
# Gateway principals[].upstream_api_key_env 优先于 proxy_api_key_env；
# 通知 notifications.credential_env 指定凭据变量名。以下名称仅为示例，
# 必须在对应配置中引用相同名称，不是程序固定识别的名称；均无默认密钥。
# MY_GATEWAY_UPSTREAM_KEY=
# MY_NOTIFICATION_CREDENTIAL=

# --- 旧 Teams 独立脚本普通模式（不配置受管通知） ---
# CLI 优先；完整 URL 优先于 host/profile/channel。以下为实际非敏感默认。
# SEND_MESSAGE_HOST=10.2.3.23:3001
# SEND_MESSAGE_PROFILE=default
# SEND_MESSAGE_CHANNEL=Default
# 密码源码存在敏感硬编码默认，不在模板复制；使用时显式填写凭据。
# SEND_MESSAGE_PASSWORD=
# 完整 URL 默认空，按分段参数生成；模式默认 text，也支持 card/card-json。
# SEND_MESSAGE_URL=
# SEND_MESSAGE_MODE=text

# --- 文件转换、编译器与 Java ---
# md-converter：默认插件目录 > 源码 bin > PATH；显式值不可用则失败。
# AIW_MD_CONVERTER=C:/path/to/md-converter.exe
# Pandoc/antiword 默认从 PATH 查找；显式值不可用则失败。
# AIW_CONVERT_PANDOC=pandoc
# AIW_CONVERT_ANTIWORD=antiword
# 浏览器默认自动查找 Edge/Chrome/Chromium；路径仅为示例。
# AIW_CONVERT_BROWSER="C:/Program Files/Google/Chrome/Application/chrome.exe"
# antiword 映射文件目录：无 AIW 默认，由外部工具使用。
# ANTIWORDHOME=C:/path/to/antiword
# BCC：环境 > PATH 检测 > C:/green/Borland/BCC55。
# BCC_ROOT=C:/green/Borland/BCC55
# MSVC：VC_HOME > VC_ROOT > VSINSTALLDIR > PATH 检测 > D:/green/VCompiler。
# VC_HOME=D:/green/VCompiler
# VC_ROOT=D:/green/VCompiler
# VSINSTALLDIR=D:/green/VCompiler
# TCC：TCC_HOME > TCC_ROOT > TCC_DIR > PATH 检测 > c:/green/tcc。
# TCC_HOME=c:/green/tcc
# TCC_ROOT=c:/green/tcc
# TCC_DIR=c:/green/tcc
# Java 默认继承；exec-java 配置可覆盖 JAVA_HOME，并前置 JDK bin 到 PATH。
# JAVA_HOME=C:/path/to/jdk
# Maven JVM 参数默认继承；exec-java 可按配置前置 file.encoding。
# MAVEN_OPTS=

# --- 编辑器、语言与终端（通常继承操作系统） ---
# Go：显式配置 > GIT_EDITOR > VISUAL > EDITOR > Git core.editor > notepad/vim。
# Node ai 编辑流程只读取 EDITOR，无默认；带空格的命令路径需保留内层引号。
# EDITOR='"C:/Program Files/Microsoft VS Code/Code.exe" --wait'
# GIT_EDITOR=notepad.exe
# VISUAL=notepad.exe
# 系统语言：LC_ALL > LANG，再走系统 locale；未设无 AIW 固定值。
# LC_ALL=zh_CN.UTF-8
# LANG=zh_CN.UTF-8
# NO_COLOR 默认未设；Go 要非空才禁色，Python FD 只要存在就禁色。
# NO_COLOR=1
# 以下默认继承，无固定值；不要用模板占位值覆盖实际终端环境。
# TERM=
# TERM_PROGRAM=
# WT_SESSION=
# ANSICON=
# ConEmuANSI=
# SHELL=
# PSModulePath=

# --- 系统目录、工具搜索、桌面与代理（仅列名，通常不要手工设置） ---
# 默认继承宿主系统，无 AIW 统一默认；空值可能破坏工具查找或目录解析。
# PATH=
# PATHEXT=
# HOME=
# USERPROFILE=
# APPDATA=
# XDG_CONFIG_HOME=
# SYSTEMROOT=
# WINDIR=
# LOCALAPPDATA=
# TEMP=
# TMP=
# WSL_INTEROP=
# WSL_DISTRO_NAME=
# WAYLAND_DISPLAY=
# DISPLAY=
# Windows 浏览器目录读取名称；LocalAppData 与 LOCALAPPDATA 在 Windows 等价。
# ProgramFiles=
# ProgramFiles(x86)=
# LocalAppData=
# HTTP_PROXY/HTTPS_PROXY/NO_PROXY 透传给 gateway Codex；由外部工具解释。
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# --- AIW 自动注入元数据（参考，不要在用户 .env 中固定） ---
# 普通插件注入：名称、路径、命令行、用户目录、可执行目录、工作目录。
# AIW_PLUGIN_NAME=
# AIW_PLUGIN_PATH=
# AIW_CMDLINE=
# AIW_HOME=
# AIW_ROOT=
# AIW_WORKSPACE=
# 安装 hook 注入：暂存目录、动作；AIW_INSTALL_DIR 也会被覆盖为安装根目录。
# AIW_PKG_STAGE=
# AIW_PKG_ACTION=
# Python cz 子进程注入，不能用来取消只读限制。
# CI=1
# GIT_TERMINAL_PROMPT=0
# AIW_CZ_READ_ONLY=1

# --- 编译/测试脚本控制项（参考，不是部署必填项） ---
# 根 build.py 编译子进程固定覆盖以下值；不要依赖父进程同名值改变它们。
# GOPROXY=off
# GOSUMDB=off
# GOTOOLCHAIN=local
# GOFLAGS=
# GOWORK=off
# CGO_ENABLED=0
# GOOS=windows
# GOARCH=amd64
# 根 compile 用 AIW_GOCACHE 决定 GOCACHE；独立 compile/测试脚本有各自缓存。
# GOCACHE=
# 测试脚本另覆盖 GOTMPDIR/TMP/TEMP/TMPDIR；这里只列其余变量名。
# GOTMPDIR=
# TMPDIR=
# proxy 联网检查脚本复用 OPENAI_API_KEY/OPENAI_MODEL，但其模型默认 gpt-6-luna；
# 本地 smoke 会注入虚拟 key 和临时状态目录，不需要填写到部署环境。

# --- 隔离 Git 调用会剔除的路由变量（参考，不要为 merge-to 配置） ---
# 无 AIW 默认；aiw git merge-to 会删除以下继承项。
# GIT_DIR=
# GIT_COMMON_DIR=
# GIT_WORK_TREE=
# GIT_INDEX_FILE=
# GIT_OBJECT_DIRECTORY=
# GIT_ALTERNATE_OBJECT_DIRECTORIES=
# GIT_NAMESPACE=
# GIT_PREFIX=
